{
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" }
  ],
  "crons": [
    { "path": "/api/cron/check-alerts", "schedule": "0 13 * * *" }
  ],
  "headers": [
    { "source": "/", "has": [{ "type": "query", "key": "year" }], "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
    { "source": "/", "has": [{ "type": "query", "key": "make" }], "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
    { "source": "/", "has": [{ "type": "query", "key": "model" }], "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
    { "source": "/", "has": [{ "type": "query", "key": "trim" }], "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
    { "source": "/", "has": [{ "type": "query", "key": "part" }], "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
    { "source": "/api/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://www.anrdoezrs.net https://www.dpbolvw.net https://www.tqlkg.com https://www.kqzyfj.com https://www.jdoqocy.com https://www.tkqlhce.com https://us.i.posthog.com https://us-assets.i.posthog.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://us.i.posthog.com https://us-assets.i.posthog.com; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ]
}
